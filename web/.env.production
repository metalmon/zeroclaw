# RU-pilot / Volt production build allowlists (UI-only cosmetic filter — see
# src/lib/channelAllowlist.ts and src/lib/toolAllowlist.ts). Read by `vite build`
# (production mode). Empty value = passthrough. Comma-separated keys to KEEP.

# Channels offered in the panel's "add channel" picker (RU-relevant set).
VITE_VOLT_CHANNELS=telegram,email,whatsapp,webhook,cli,filesystem,plugin,voice_call,voice_wake,voice_duplex,mqtt,amqp,git,matrix,signal,mattermost,nextcloud_talk,gmail_push

# Tools shown in the tool catalog/pickers. Empty = keep all tools.
VITE_VOLT_TOOLS=

# Config sections hidden from the settings navigator (see src/lib/sectionFilter.ts).
# Integrations not part of the RU offering. Comma-separated section keys; empty = show all.
VITE_VOLT_HIDE_SECTIONS=jira,linkedin,notion

# Model providers KEPT in the /integrations catalog's AiModel category (see
# src/lib/providerAllowlist.ts). Comma-separated display names; empty = show all.
VITE_VOLT_PROVIDERS=Ollama,LM Studio,LiteLLM,Custom (OpenAI-compatible),SGLang,OpenAI,Anthropic,OpenRouter,DeepSeek,Google Gemini,Mistral,Groq,Qwen (DashScope / Qwen Code OAuth),GLM (Zhipu),Azure OpenAI,Vercel AI Gateway
